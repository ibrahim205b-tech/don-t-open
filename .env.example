# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع ملف .env إلى GitHub.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# الرابط العام للموقع (يُستخدم في الروابط القانونية وsitemap والتحقق من مصدر الطلبات)
BASE_URL=https://example.com
# سلسلة عشوائية طويلة (64 حرفاً على الأقل). مثال لتوليدها:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_PATH=./data/dalil.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./backups
# اجعلها true فقط إذا كان التطبيق خلف وكيل عكسي موثوق (Nginx/Render/Fly)
TRUST_PROXY=false
# إلزام حسابات الإدارة بالتحقق بخطوتين (TOTP)
ADMIN_REQUIRE_MFA=true

# تُستخدم فقط مع: npm run admin:create
ADMIN_NAME=
ADMIN_PHONE=
# اتركها فارغة ليُطلب إدخالها بشكل مخفي في الطرفية
ADMIN_PASSWORD=
